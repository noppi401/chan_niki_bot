# ニキ (Discord bot + mcp_server.py) 用環境変数。
# Ubuntu では本ファイルを .env にコピーして値を埋める:
#   cp .env.example .env && nano .env
# aivenv は別 .env（../vm-play-server/.env）を使う点に注意（下部参照）。
# bot は network_mode: host で動くため localhost 参照がそのまま機能する。

# ── Discord / OpenAI / Google ──────────────────────────────────────────
DISCORD_BOT_TOKEN=
OPENAI_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# ── ngrok（ニキが管理するトンネル） ────────────────────────────────────
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# ── ポート ─────────────────────────────────────────────────────────────
TRPG_PORT=3001
AIVENV_LOG_PORT=8081

# ── サービス連携（host ネットワークなので 127.0.0.1 で届く） ────────────
AIVENV_API_URL=http://127.0.0.1:8080
# TRPG Terminal の ngrok URL ファイル（併設時のみ。docker-compose で同パスをマウント）
TRPG_NGROK_URL_FILE=/opt/products/trpg_terminal/ngrok-url.txt

# ── 参考 ────────────────────────────────────────────────────────────────
# aivenv 用のキーは ../vm-play-server/.env に置く（こちらではない）:
#   OPENAI_API_KEY=        # ニキの OPENAI_KEY とは別名。aivenv は OPENAI_API_KEY を読む
#   NGROK_AUTHTOKEN=
# aivenv の作業ディレクトリ（ホスト側パス。start-prod.sh が mkdir する）:
#   AIVENV_WORK_DIR=/opt/aivenv/work   # シェル環境変数として渡す。既定は /opt/aivenv/work
